// Posts keystrokes and scroll-wheel events for mpk249-keys.js, one per line
// read from stdin (JavaScript for Automation: osascript -l JavaScript):
//
//     key <keycode> <mods>     mods: cmd,alt,shift,ctrl joined by commas, or -
//     hscroll <lines>          a horizontal scroll at the pointer
//     ping                     answers "pong"
//
// Replies and errors go to stderr. A scroll goes to whatever is under the
// pointer, as a mouse's would.
//
// A key goes to whichever window has the keyboard - and in a plug-in's
// window an arrow key can change the patch, wiping the work in it. So a key
// is typed only into Live's main window: if anything else has the keyboard,
// the main window is raised first, and if that cannot be confirmed the key is
// dropped ("skipped: ..."). Reading windows needs System Events (Automation
// permission, asked once).

ObjC.import("Foundation");
ObjC.import("CoreGraphics");
ObjC.import("ApplicationServices");

var FLAGS = { cmd: 0x100000, alt: 0x80000, shift: 0x20000, ctrl: 0x40000 };

function say(text) {
    $.NSFileHandle.fileHandleWithStandardError.writeData($(text + "\n").dataUsingEncoding($.NSUTF8StringEncoding));
}

var MODIFIER_KEYS = { cmd: 55, alt: 58, shift: 56, ctrl: 59 };

function post(code, down, flags) {
    var event = $.CGEventCreateKeyboardEvent(null, code, down);
    $.CGEventSetFlags(event, flags);
    $.CGEventPost($.kCGHIDEventTap, event);
}

/*  Typed as a hand would: each modifier pressed, the key, then the modifiers
    released. Flags alone on the key's event were not enough for Cmd-Alt-P -
    an app may read which modifiers are held from the keyboard's state rather
    than from the event.
*/
var systemEvents = null;
var confirmedAt = 0;            // when the main window was last seen to have the keyboard

// Live's main window: its largest ordinary window - plug-in windows are smaller.
function mainWindow(live) {
    var best = null, bestArea = 0;

    live.windows().forEach(function (w) {
        try {
            if (w.subrole() !== "AXStandardWindow")
                return;

            var size = w.size();
            var area = size[0] * size[1];

            if (area > bestArea) {
                best = w;
                bestArea = area;
            }
        } catch (e) {}
    });

    return best;
}

function sameWindow(a, b) {
    return a.name() === b.name() && a.position().join() === b.position().join() && a.size().join() === b.size().join();
}

// "" when a key typed now reaches Live's main window, else why not.
function keyboardInLiveMain() {
    if (systemEvents === null)
        systemEvents = Application("System Events");

    var front = systemEvents.applicationProcesses.whose({ frontmost: true });

    if (front.length === 0)
        return "no app in front";

    var live = front[0];

    if (live.name() !== "Live")
        return live.name() + " is in front, not Live";

    var main = mainWindow(live);

    if (main === null)
        return "Live's main window was not found";

    var focused = function () { return live.attributes.byName("AXFocusedWindow").value(); };

    if (sameWindow(focused(), main))
        return "";

    // A plug-in window (or a dialog) has the keyboard: hand it to the main window.
    var other = focused().name();
    main.actions.byName("AXRaise").perform();
    delay(0.08);

    return sameWindow(focused(), main) ? "" : "'" + other + "' has the keyboard";
}

function key(code, mods) {
    var now = Date.now();

    // Checked at most every 250 ms: a knob turned fast types many arrows.
    if (now - confirmedAt > 250) {
        var why;

        try { why = keyboardInLiveMain(); }
        catch (e) { why = "could not read Live's windows (" + e + ")"; }

        if (why !== "") {
            say("skipped: " + why);
            confirmedAt = 0;
            return;
        }

        confirmedAt = now;
    }

    var held = mods.split(",").filter(function (m) { return MODIFIER_KEYS[m] !== undefined; });
    var flags = 0;

    held.forEach(function (m) {
        flags |= FLAGS[m];
        post(MODIFIER_KEYS[m], true, flags);
    });

    post(code, true, flags);
    post(code, false, flags);

    held.slice().reverse().forEach(function (m) {
        flags &= ~FLAGS[m];
        post(MODIFIER_KEYS[m], false, flags);
    });
}

function hscroll(lines) {
    // Wheel 1 is vertical, wheel 2 horizontal.
    var event = $.CGEventCreateScrollWheelEvent2(null, $.kCGScrollEventUnitLine, 2, 0, lines, 0);
    $.CGEventPost($.kCGHIDEventTap, event);
}

function handle(line) {
    var words = line.trim().split(/\s+/);

    if (words[0] === "key" && words.length >= 2)
        key(parseInt(words[1], 10), words[2] || "-");
    else if (words[0] === "hscroll" && words.length >= 2)
        hscroll(parseInt(words[1], 10));
    else if (words[0] === "ping")
        say("pong");
    else if (words[0] !== "")
        say("unknown: " + line);
}

function run() {
    // Asks macOS to prompt for the permission if it has not been given.
    var noPrompt = $.NSProcessInfo.processInfo.environment.objectForKey("MPK249_NO_PROMPT").js;   // a test's
    var trusted = noPrompt ? $.AXIsProcessTrusted()
                           : $.AXIsProcessTrustedWithOptions($({ AXTrustedCheckOptionPrompt: true }));
    say(trusted ? "trusted yes" : "trusted no");

    var input = $.NSFileHandle.fileHandleWithStandardInput;
    var pending = "";

    for (;;) {
        var data = input.availableData;

        // A bridged NSUInteger, not a JS number: === 0 never matched.
        if (Number(data.length) === 0)
            return;     // stdin closed: the device went away

        pending += $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
        var lines = pending.split("\n");
        pending = lines.pop();
        lines.forEach(handle);
    }
}
